@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/refs/heads/master/C4_Container.puml

Person(customer, "Клиент")
Person(callCenterSpecialist, "Сотрудник колл-центра")
Person_Ext(externalCallCenterSpecialist, "Сотрудник партнерского колл-центра")
Person(depositSpecialist, "Специалист депозитного отдела")

System_Boundary(depositServices, "Депозитные микросервисы") {
    Container(apiGateway, "API Gateway", "ASP.NET", "Маршрутизация запросов")
    Container(depositRatesService, "Сервис депозитных ставок", "ASP.NET", "Расчет ставок для клиентов")

    ContainerDb(depositRatesDatabase, "БД ставок по депозитам", "PostgreSQL")

    ContainerQueue(messageBroker, "Message broker", "Kafka")
    Container(sftpServer, "Файловый сервер", "SFTP")
}
Container(callCenterSystem, "Внутренняя система колл-центра")
Container_Ext(externalCallCenterSystem, "Партнерская система колл-центра")

Rel_D(customer, callCenterSpecialist, "Консультируется по ставкам")
Rel_D(customer, externalCallCenterSpecialist, "Консультируется по ставкам")

Rel(depositRatesService, messageBroker, "Уведомляет об обновлении ставок", "Kafka")
Rel_D(callCenterSpecialist, callCenterSystem, "Получает информацию о ставках")
Rel_U(messageBroker, callCenterSystem, "Уведомляет об обновлении ставок", "Kafka")
Rel(callCenterSystem, apiGateway, "Запрашивает актуальные ставки")

Rel_U(depositRatesService, sftpServer, "Загружает файл со ставками", "SFTP")
Rel_D(externalCallCenterSpecialist, sftpServer, "Получает актуальные ставки", "SFTP")
Rel_D(externalCallCenterSpecialist, externalCallCenterSystem, "Обновляет/получает информацию о ставках")

Rel_U(depositSpecialist, apiGateway, "Обновляет информацию о ставках")
Rel_U(apiGateway, depositRatesService, "Маршрутизирует запросы", "REST API")
Rel(depositRatesService, depositRatesDatabase, "Данные о ставках", "SQL")
@enduml